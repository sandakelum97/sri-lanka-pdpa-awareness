---
import { site } from '../lib/site';
import { twinPath } from '../lib/i18n';
interface Props { lang: 'en' | 'si'; path: string }
const { lang, path } = Astro.props;
const other = lang === 'en' ? 'si' : 'en';
const twin = await twinPath(path, lang);
const otherPath = twin.href;
const t = lang === 'en'
  ? { sections: 'The Act', scenarios: 'Real situations', pathways: 'Start here', faq: 'Questions', glossary: 'Glossary', status: 'What is in force', downloads: 'Official documents', search: 'Search', switch: 'සිංහල' }
  : { sections: 'පනත', scenarios: 'සැබෑ අවස්ථා', pathways: 'මෙතැනින් පටන් ගන්න', faq: 'ප්‍රශ්න', glossary: 'වචන මාලාව', status: 'ක්‍රියාත්මක මොනවාද', downloads: 'නිල ලේඛන', search: 'සොයන්න', switch: 'English' };
const cur = (p: string) => (path.startsWith(`/${lang}/${p}`) ? 'page' : undefined);
---
<header class="site-header"><div class="inner">
  <a class="brand" href={`/${lang}/`}>
    <img src="/brand/mark.svg" alt="" width="34" height="36" />
    <span class="si">{site.name.si}</span><span class="en">{site.name.en}<small>{site.tagline[lang]}</small></span>
  </a>
  <button class="menu-btn" aria-expanded="false" aria-controls="primary-nav" aria-label={lang === 'en' ? 'Menu' : 'මෙනුව'}><span></span><span></span><span></span></button>
  
  <nav class="primary" id="primary-nav" aria-label={lang === 'en' ? 'Main' : 'ප්‍රධාන'}>
    <a href={`/${lang}/pathways/`} aria-current={cur('pathways')}>{t.pathways}</a>
    <a href={`/${lang}/scenarios/`} aria-current={cur('scenarios')}>{t.scenarios}</a>
    <a href={`/${lang}/sections/`} aria-current={cur('sections')}>{t.sections}</a>
    <a href={`/${lang}/status/`} aria-current={cur('status')}>{t.status}</a>
    <a href={`/${lang}/faq/`} aria-current={cur('faq')}>{t.faq}</a>
    <a href={`/${lang}/glossary/`} aria-current={cur('glossary')}>{t.glossary}</a>
    <a href={`/${lang}/downloads/`} aria-current={cur('downloads')}>{t.downloads}</a>
    <a href={`/${lang}/search/`} aria-current={cur('search')}>{t.search}</a>
    <a class="lang" href={otherPath} lang={other} hreflang={other} title={twin.exact ? undefined : (lang === 'en' ? 'Sinhala version of this page is not ready yet — opens the Sinhala section' : '')}>{t.switch}{!twin.exact && <span class="soon-dot" aria-hidden="true"> ·</span>}</a>
  </nav>
</div></header>
<script is:inline>
(()=>{const b=document.querySelector('.menu-btn'),n=document.getElementById('primary-nav');if(!b||!n)return;b.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));n.classList.toggle('open',!o);});})();
</script>

---
import Header from '../components/Header.astro';
import Welcome from '../components/Welcome.astro';
import { asOf } from '../lib/status';
import { site } from '../lib/site';
import '../styles/global.css';
interface Props { title: string; lang?: 'en' | 'si'; description?: string; welcome?: boolean }
const { title, lang = 'en', description = '', welcome = false } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={lang === 'si' ? 'si-LK' : 'en-LK'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name.en}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" />
    <meta name="theme-color" content="#0F6E6B" />
    
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : 'අන්තර්ගතයට යන්න'}</a>
    <Header lang={lang} path={path} />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <footer class="site-footer"><div class="inner">
      <div>
        <p><strong>{site.name.si} · {site.name.en}</strong> — {site.kind[lang]}.</p>
        <p>{lang === 'en'
          ? 'We are not the Data Protection Authority of Sri Lanka and we are not part of the Government. Nothing here is legal advice. Every explanation links to the official text so you can check it yourself.'
          : 'අපි ශ්‍රී ලංකා දත්ත ආරක්ෂණ අධිකාරිය නොවෙමු; රජයේ කොටසක් ද නොවෙමු. මෙහි ඇති කිසිවක් නීති උපදෙස් නොවේ. සෑම පැහැදිලි කිරීමක් ම ඔබට ම පරීක්ෂා කළ හැකි වන පරිදි නිල පාඨයට සබැඳී ඇත.'}</p>
      </div>
      <div>
        <p>{lang === 'en' ? 'Legal status last checked:' : 'නීතිමය තත්ත්වය අවසන් වරට පරීක්ෂා කළේ:'} {asOf}</p>
        <p><a href="https://www.dpa.gov.lk/guidelines.php" rel="noopener">{lang === 'en' ? 'Official documents at dpa.gov.lk' : 'නිල ලේඛන — dpa.gov.lk'}</a></p>
        <p>{lang === 'en' ? 'No cookies. No trackers. Search runs on your device.' : 'කුකීස් නැත. ට්‍රැකර් නැත. සෙවීම ඔබේ උපකරණයේ ම සිදු වේ.'} {welcome && <a href="#" data-open-welcome>{lang === 'en' ? 'Change language or audience' : 'භාෂාව හෝ කණ්ඩායම වෙනස් කරන්න'}</a>}</p>
        <p><a href={`/${lang}/downloads/`}>{lang === 'en' ? 'Official documents' : 'නිල ලේඛන'}</a> · <a href={`/${lang}/about/`}>{lang === 'en' ? 'About this project' : 'මේ ව්‍යාපෘතිය ගැන'}</a> · <a href={site.repo} rel="noopener">{lang === 'en' ? 'Source on GitHub' : 'GitHub'}</a></p>
      </div>
    </div></footer>
    {welcome && <Welcome lang={lang} />}
  </body>
</html>
